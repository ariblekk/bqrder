# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=qrdigo
DB_SSLMODE=disable

# JWT — in production replace with two different random strings >=32 chars
# (e.g. `openssl rand -hex 32`). The server refuses to start with weak values.
JWT_SECRET=ubah-ini-jadi-secret-yang-kuat
JWT_REFRESH_SECRET=ubah-ini-jadi-refresh-secret-yang-kuat
JWT_EXPIRY_HOURS=24
JWT_REFRESH_DAYS=7

# Server
APP_ENV=development
SERVER_PORT=8080
BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# Upload
UPLOAD_PATH=./uploads

# Only set when the API sits behind a reverse proxy, comma-separated CIDRs/IPs
# whose X-Forwarded-For header should be trusted for rate limiting.
# TRUSTED_PROXIES=10.0.0.0/8