# Copy to `.env` at the repo root and fill with strong values.
# Used by `docker compose` (root docker-compose.yml).

# Database
DB_USER=qrdigo
DB_PASSWORD=ubah-ini-jadi-password-kuat
DB_NAME=qrdigo

# JWT — two different random strings >=32 chars, e.g. `openssl rand -hex 32`.
# The API refuses to start with weak values when APP_ENV=production.
JWT_SECRET=ubah-ini-jadi-secret-yang-kuat
JWT_REFRESH_SECRET=ubah-ini-jadi-refresh-secret-yang-kuat

# Server
# `development` runs locally (localhost URLs allowed). For production set
# `production` and point BASE_URL/FRONTEND_URL at public addresses — the API
# refuses localhost URLs in production.
APP_ENV=development
BASE_URL=http://localhost:2301
FRONTEND_URL=http://localhost:2301

# Business timezone (IANA name). Order numbers, receipts, and report date
# boundaries use this instead of the server clock (e.g. UTC in containers).
APP_TIMEZONE=Asia/Jakarta

# Push notifications (optional). Firebase service account JSON content or file
# path. Leave empty to disable push.
FCM_CREDENTIALS=

# Only set when the API sits behind a reverse proxy, comma-separated CIDRs/IPs
# whose X-Forwarded-For header should be trusted for rate limiting.
# TRUSTED_PROXIES=10.0.0.0/8